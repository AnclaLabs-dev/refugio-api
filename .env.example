PORT=3000
DATABASE_URL=postgresql://usuario:password@host:puerto/railway
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FRONTEND_URL=http://localhost:5173
# Solo para el script "npm run token" (apiKey pública de la config web de Firebase)
FIREBASE_WEB_API_KEY=
# Cotizaciones: clave Demo gratuita de CoinGecko (opcional, pero recomendada) y vigencia de la caché
COINGECKO_API_KEY=
RATES_TTL_MINUTES=10
# Spread total aplicado a las cotizaciones cripto (0.01 = 1%, mitad de cada lado)
CRYPTO_SPREAD=0.01
# Chatbot: clave de Google AI Studio (Gemini). Sin clave, POST /chat responde 503
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
# Menos razonamiento = respuestas más rápidas (low | medium | high)
AI_REASONING_EFFORT=low
AI_PRIMARY_TIMEOUT_MS=15000
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Respaldo del chatbot (OpenRouter): se usa solo si Gemini falla. Sin clave, no hay respaldo
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODELS=openrouter/free
# AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
CHAT_MESSAGES_PER_MINUTE=10
CHAT_MESSAGES_PER_DAY=200
