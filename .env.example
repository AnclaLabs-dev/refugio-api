PORT=3000
DATABASE_URL=postgresql://usuario:password@host:puerto/railway
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FRONTEND_URL=http://localhost:5173
# Solo para el script "npm run token" (apiKey pública de la config web de Firebase)
FIREBASE_WEB_API_KEY=
# Cotizaciones: clave Demo gratuita de CoinGecko (opcional, pero recomendada) y vigencia de la caché
COINGECKO_API_KEY=
RATES_TTL_MINUTES=10
# Spread total aplicado a las cotizaciones cripto (0.01 = 1%, mitad de cada lado)
CRYPTO_SPREAD=0.01
